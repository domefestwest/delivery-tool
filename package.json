{
  "name": "dome-festival-delivery-tool",
  "version": "0.17.3",
  "description": "Universal H.265 10-bit delivery encoder for fulldome film festivals — config-driven, cross-platform, open source",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"BROWSER=none react-scripts start\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "react-scripts build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always",
    "test": "node test/cross-platform.test.js",
    "devtest": "node scripts/devtest.js",
    "devtest:all": "node scripts/devtest.js all",
    "devtest:presets": "node scripts/devtest.js presets",
    "devtest:screenshots": "npm run build && electron scripts/screenshot-sizes.js"
  },
  "build": {
    "appId": "org.domefestival.delivery-tool",
    "productName": "Dome Festival Delivery Tool",
    "copyright": "Copyright © 2027 Dome Festival Delivery Tool contributors",
    "extends": null,
    "asar": true,
    "afterPack": "./scripts/after-pack.js",
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "domefestwest",
        "repo": "delivery-tool",
        "releaseType": "release"
      }
    ],
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "src-main/**/*",
      "presets/**/*",
      "node_modules/**/*",
      "!node_modules/electron/dist/**/*",
      "!**/{.eslintrc.js,jest.config.js,.gitignore,.npmignore}"
    ],
    "extraResources": [
      {
        "from": "ffmpeg/mac",
        "to": "ffmpeg/mac",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "ffmpeg/win",
        "to": "ffmpeg/win",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "ffmpeg/linux",
        "to": "ffmpeg/linux",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "presets",
        "to": "presets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "examples",
        "to": "examples",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Dome-Festival-Delivery-Tool-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Dome-Festival-Delivery-Tool-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "artifactName": "Dome-Festival-Delivery-Tool-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dome Festival Delivery"
    }
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/domefestwest/delivery-tool.git"
  },
  "bugs": {
    "url": "https://github.com/domefestwest/delivery-tool/issues"
  },
  "author": {
    "name": "Dome Festival Delivery Tool contributors",
    "email": "Ryan@domefestwest.com",
    "url": "https://github.com/domefestwest/delivery-tool"
  }
}
